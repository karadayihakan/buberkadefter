<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_gib" model="ir.ui.view">
        <field name="name">account.move.form.gib</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- GIB send button in header -->
            <xpath expr="//button[@name='action_post']" position="after">
                <field name="gib_can_send" invisible="1"/>
                <button name="action_send_to_gib"
                        type="object"
                        string="GIB Portal'a Gonder"
                        class="btn-primary"
                        invisible="not gib_can_send"
                        confirm="Fatura GIB e-Arsiv portalina gonderilecek. Devam etmek istiyor musunuz?"/>
                <button name="action_match_from_gib"
                        type="object"
                        string="GIB'den Eslestir"
                        class="btn-secondary"
                        invisible="not gib_can_send"
                        confirm="GIB portalindan fatura eslestirilecek. Devam?"/>
            </xpath>
            <!-- GIB fields after ref -->
            <xpath expr="//field[@name='ref']" position="after">
                <field name="earsiv_pdf" filename="earsiv_pdf_name"
                       widget="binary" string="E-Arsiv PDF" readonly="0"/>
                <field name="earsiv_pdf_name" invisible="1"/>
                <field name="gib_uuid" readonly="1"
                       invisible="not gib_uuid"/>
                <field name="gib_status" readonly="1"
                       invisible="gib_status == 'draft'"
                       widget="badge"
                       decoration-success="gib_status == 'sent'"
                       decoration-danger="gib_status == 'error'"/>
                <field name="gib_error_message" readonly="1"
                       invisible="gib_status != 'error'"/>
            </xpath>
            <!-- GIB PDF button in button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="gib_pdf_id" invisible="1"/>
                <button name="action_download_gib_pdf"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-pdf-o"
                        invisible="not gib_pdf_id">
                    <span>GIB e-Arsiv PDF</span>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
