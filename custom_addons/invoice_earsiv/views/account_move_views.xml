<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_earsiv" model="ir.ui.view">
        <field name="name">account.move.form.earsiv</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add E-Arsiv PDF field after ref field in the header area -->
            <xpath expr="//field[@name='ref']" position="after">
                <field name="earsiv_pdf" filename="earsiv_pdf_name"
                       widget="binary"
                       string="E-Arsiv PDF"/>
                <field name="earsiv_pdf_name" invisible="1"/>
            </xpath>
            <!-- Add download button in the button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="earsiv_uploaded" invisible="1"/>
                <button name="action_download_earsiv"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-pdf-o"
                        invisible="not earsiv_uploaded">
                    <span>E-Arsiv PDF</span>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
